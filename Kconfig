mainmenu "CCSDS EYE demo"

choice EYE_DEMO_ROLE
	prompt "Demo role"
	default EYE_DEMO_ROLE_A

config EYE_DEMO_ROLE_A
	bool "EYE A"

config EYE_DEMO_ROLE_B
	bool "EYE B"

endchoice

choice EYE_DEMO_LINK_SECURITY
	prompt "USLP link security"
	default EYE_DEMO_LINK_CLEAR

config EYE_DEMO_LINK_CLEAR
	bool "Clear USLP/COP-1"

config EYE_DEMO_LINK_SDLS
	bool "Stage 2 SDLS authenticated encryption"
	select CCSDS_SDLS
	select ENTROPY_GENERATOR
	help
	  Protect packet-bearing Type-AD frames with fixed prototype keys and a
	  bounded in-session ARSN check. Boot and local SYNC arm authenticated
	  receive-baseline adoption. While adoption is armed, a previously recorded
	  valid fixed-key frame can establish the baseline; fresh Stage 3 keys are
	  required to exclude that replay case.

endchoice

config EYE_DEMO_CALLSIGN
	string "Local callsign"
	default "EYE-1" if EYE_DEMO_ROLE_A
	default "EYE-2" if EYE_DEMO_ROLE_B

config EYE_DEMO_PEER_CALLSIGN
	string "Peer callsign"
	default "EYE-2" if EYE_DEMO_ROLE_A
	default "EYE-1" if EYE_DEMO_ROLE_B

config EYE_DEMO_LOCAL_ENTITY_ID
	int "Local CFDP entity ID"
	default 1 if EYE_DEMO_ROLE_A
	default 2 if EYE_DEMO_ROLE_B
	range 1 255

config EYE_DEMO_PEER_ENTITY_ID
	int "Peer CFDP entity ID"
	default 2 if EYE_DEMO_ROLE_A
	default 1 if EYE_DEMO_ROLE_B
	range 1 255

config EYE_DEMO_WIFI_SSID
	string "Wi-Fi SSID"
	default ""

config EYE_DEMO_WIFI_PASSWORD
	string "Wi-Fi WPA2 password"
	default ""

config EYE_DEMO_LOCAL_IPV4
	string "Local static IPv4 address"
	default "192.0.2.1"

config EYE_DEMO_PEER_IPV4
	string "Peer static IPv4 address"
	default "192.0.2.2"

config EYE_DEMO_NETMASK
	string "IPv4 netmask"
	default "255.255.255.0"

config EYE_DEMO_GATEWAY
	string "IPv4 gateway"
	default "192.0.2.254"

config EYE_DEMO_LOCAL_UDP_PORT
	int "Local UDP port"
	default 46001
	range 1024 65535

config EYE_DEMO_PEER_UDP_PORT
	int "Peer UDP port"
	default 46002
	range 1024 65535

config EYE_DEMO_CFDP_APID
	hex "CFDP Space Packet APID"
	default 0x350
	range 1 0x7ff

config EYE_DEMO_COMMAND_APID
	hex "CAPTURE_AND_RETURN TC APID"
	default 0x351
	range 1 0x7ff

config EYE_DEMO_COMMAND_STATUS_APID
	hex "Command status Space Packet APID"
	default 0x352
	range 1 0x7ff

config EYE_DEMO_PEER_STATUS_APID
	hex "Peer status Space Packet APID"
	default 0x353
	range 1 0x7ff

config EYE_DEMO_RECOVERY_APID
	hex "SDLS recovery election Space Packet APID"
	default 0x354
	range 1 0x7ff

config EYE_DEMO_OTAR_APID
	hex "SDLS recovery OTAR Space Packet APID"
	default 0x355
	range 1 0x7ff

config EYE_DEMO_LOCAL_SPACECRAFT_ID
	hex "Local USLP spacecraft ID"
	default 0x1001 if EYE_DEMO_ROLE_A
	default 0x1002 if EYE_DEMO_ROLE_B
	range 0 0xffff

config EYE_DEMO_PEER_SPACECRAFT_ID
	hex "Remote USLP spacecraft ID"
	default 0x1002 if EYE_DEMO_ROLE_A
	default 0x1001 if EYE_DEMO_ROLE_B
	range 0 0xffff

config EYE_DEMO_LOCAL_SCID_IS_SOURCE
	bool "Local spacecraft ID uses the USLP source indication"
	default y

config EYE_DEMO_PEER_SCID_IS_SOURCE
	bool "Remote spacecraft ID uses the USLP source indication"
	default y

config EYE_DEMO_TRANSMIT_VCID
	int "Transmit USLP virtual channel ID"
	default 1
	range 0 62

config EYE_DEMO_RECEIVE_VCID
	int "Receive USLP virtual channel ID"
	default 1
	range 0 62

config EYE_DEMO_TRANSMIT_MAP_ID
	int "Transmit USLP MAP ID"
	default 3
	range 0 15

config EYE_DEMO_RECEIVE_MAP_ID
	int "Receive USLP MAP ID"
	default 3
	range 0 15

config EYE_DEMO_RETRANSMISSION_TIMEOUT_MS
	int "COP-1 retransmission timeout (ms)"
	default 500
	range 1 60000

config EYE_DEMO_FEEDBACK_INTERVAL_MS
	int "Idle repeated CLCW feedback interval (ms)"
	default 1000
	range 1 60000

config EYE_DEMO_MINIMUM_TRANSMIT_INTERVAL_MS
	int "Minimum USLP route interval (ms)"
	default 20
	range 1 1000

config EYE_DEMO_TRANSMISSION_LIMIT
	int "COP-1 transmission limit"
	default 12
	range 1 255

config EYE_DEMO_FARM_WINDOW_WIDTH
	int "COP-1 FARM window width"
	default 8
	range 2 254

config EYE_DEMO_INITIAL_TRANSMIT_SEQUENCE
	int "Initial transmit sequence"
	default 0
	range 0 255

config EYE_DEMO_INITIAL_RECEIVE_SEQUENCE
	int "Initial receive sequence"
	default 0
	range 0 255

choice EYE_DEMO_FAULT
	prompt "Deterministic USLP route fault"
	default EYE_DEMO_FAULT_NONE

config EYE_DEMO_FAULT_NONE
	bool "Disabled"

config EYE_DEMO_FAULT_DROP_DATA
	bool "Drop first packet-bearing frame during a transfer"

config EYE_DEMO_FAULT_DROP_FEEDBACK
	bool "Drop first feedback-only frame during a transfer"

config EYE_DEMO_FAULT_WITHHOLD_FEEDBACK
	bool "Withhold a bounded run of feedback-only frames during a transfer"

endchoice

config EYE_DEMO_FAULT_WITHHOLD_COUNT
	int "Number of feedback-only frames to withhold"
	default 12
	range 1 255

source "Kconfig.zephyr"
