mainmenu "CCSDS EYE demo"

choice EYE_DEMO_ROLE
	prompt "Demo role"
	default EYE_DEMO_ROLE_A

config EYE_DEMO_ROLE_A
	bool "EYE A"

config EYE_DEMO_ROLE_B
	bool "EYE B"

endchoice

config EYE_DEMO_CALLSIGN
	string "Local callsign"
	default "EYE-1" if EYE_DEMO_ROLE_A
	default "EYE-2" if EYE_DEMO_ROLE_B

config EYE_DEMO_PEER_CALLSIGN
	string "Peer callsign"
	default "EYE-2" if EYE_DEMO_ROLE_A
	default "EYE-1" if EYE_DEMO_ROLE_B

config EYE_DEMO_LOCAL_ENTITY_ID
	int "Local CFDP entity ID"
	default 1 if EYE_DEMO_ROLE_A
	default 2 if EYE_DEMO_ROLE_B
	range 1 255

config EYE_DEMO_PEER_ENTITY_ID
	int "Peer CFDP entity ID"
	default 2 if EYE_DEMO_ROLE_A
	default 1 if EYE_DEMO_ROLE_B
	range 1 255

config EYE_DEMO_WIFI_SSID
	string "Wi-Fi SSID"
	default ""

config EYE_DEMO_WIFI_PASSWORD
	string "Wi-Fi WPA2 password"
	default ""

config EYE_DEMO_LOCAL_IPV4
	string "Local static IPv4 address"
	default "192.0.2.1"

config EYE_DEMO_PEER_IPV4
	string "Peer static IPv4 address"
	default "192.0.2.2"

config EYE_DEMO_NETMASK
	string "IPv4 netmask"
	default "255.255.255.0"

config EYE_DEMO_GATEWAY
	string "IPv4 gateway"
	default "192.0.2.254"

config EYE_DEMO_LOCAL_UDP_PORT
	int "Local UDP port"
	default 46001
	range 1024 65535

config EYE_DEMO_PEER_UDP_PORT
	int "Peer UDP port"
	default 46002
	range 1024 65535

config EYE_DEMO_CFDP_APID
	hex "CFDP Space Packet APID"
	default 0x350
	range 1 0x7ff

config EYE_DEMO_COMMAND_APID
	hex "CAPTURE_AND_RETURN TC APID"
	default 0x351
	range 1 0x7ff

config EYE_DEMO_COMMAND_STATUS_APID
	hex "Command status Space Packet APID"
	default 0x352
	range 1 0x7ff

config EYE_DEMO_PEER_STATUS_APID
	hex "Peer status Space Packet APID"
	default 0x353
	range 1 0x7ff

source "Kconfig.zephyr"
